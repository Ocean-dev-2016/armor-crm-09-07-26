# LiteSpeed: allow long PDF API requests (Order s=98, Quotation s=163).
# Prevents "Request Timeout" while service_genral.php generates PDF.
<IfModule LiteSpeed>
	RewriteEngine On
	RewriteRule .* - [E=noabort:1,E=noconntimeout:1]
</IfModule>

<IfModule mod_env.c>
	SetEnv noabort 1
	SetEnv noconntimeout 1
</IfModule>
