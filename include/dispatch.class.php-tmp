	//-------------Get order Detail----------------//
	public function GetOrder($detail) {

		$where    = " id='".$detail['id']."' AND isDelete=0";
		$ctable_r = $this->db->rp_getData($this->ctable, "*", $where, 0);
		$ctable_d = mysqli_fetch_array($ctable_r);

		$result                 = array();
		$result['total_amount'] = htmlentities($ctable_d['total_amount']);
		$result['total_qty']    = htmlentities($ctable_d['total_qty']);
		$result['grand_total']  = htmlentities($ctable_d['grand_total']);
		// Purchase Item

		$reply = array("ack" => 1, "developer_msg" => "Product Item detail fetched!!.", "ack_msg" => "Success! Product Item Edit Successfully.", "result" => $result);
		return $reply;

	}
	//------------get All ordered Product Item------------------//
	public function GetOrderItems($detail) {
		$where       = "order_id='".$detail['id']."' AND isDelete=0";
		$ctable_item = $this->db->rp_getData("order_product_item", "*", $where, "", 0);
		if ($ctable_item) {
			while ($ctable_item_d = mysqli_fetch_array($ctable_item)) {
				$result_item                 = array();
				$result_item['product_id']   = htmlentities($ctable_item_d['pro_id']);
				$result_item['weight_id']    = htmlentities($ctable_item_d['weight_id']);
				$result_item['product_name'] = htmlentities($ctable_item_d['pro_name']);
				//$result_item['product_code']	= htmlentities($ctable_item_d['product_code']);
				$result_item['qty']           = htmlentities($ctable_item_d['pro_qty']);
				$result_item['product_price'] = $this->db->rp_num(htmlentities($ctable_item_d['unitprice']));
				$result_item['product_total'] = $this->db->rp_num(htmlentities($ctable_item_d['totalprice']));
				$result[]                     = $result_item;
			}
			$reply = array("ack" => 1, "developer_msg" => "Product Item detail fetched!!.", "ack_msg" => "Success! Update Product Item Successfully.", "result" => $result);
			return $reply;
		} else {
			$reply = array("ack" => 0, "developer_msg" => "Update not fetched!!.", "ack_msg" => "Success! Update Failed");
			return $reply;
		}
	}
	//------------------Delete Order Also Delete product item-----------------	//
	public function DeleteDispatch($detail) {
		$rows = array(
			"isDelete" => "1"
		);
		$where = "id='".$_REQUEST['id']."'";
		/*log entry*/
		$customer_id     = $this->db->rp_getValue("dispatch_detail", "customer_id", "id='".$_REQUEST['id']."'");
		$dispatch_no     = $this->db->rp_getValue("dispatch_detail", "dispatch_no", "id='".$_REQUEST['id']."'");
		$module_name     = "Dispatch";
		$flag            = "Web";
		$log_description = $module_name." ".$dispatch_no." Deleted By ".$_SESSION[SITE_SESS.'SESS_NAME']." ON ".date("Y-m-d H:i:s");
		/*log entry*/
		$where_item   = "dispatch_id='".$_REQUEST['id']."'";
		$isUpdated_id = $this->db->rp_update($this->ctable, $rows, $where, 0, $log_description, $flag, $module_name, "", $customer_id);
		$id           = $this->db->rp_update("dispatch_item", $rows, $where_item);
		if ($isUpdated_id) {
			$dispatch_d = $this->db->rp_getData("dispatch_item", "*", "dispatch_id='".$_REQUEST['id']."'", "", 0);
			while ($dispatch_r = mysqli_fetch_array($dispatch_d)) {
				$pro_id    = $dispatch_r['pro_id'];
				$weight_id = $dispatch_r['weight_id'];
				$qty       = $dispatch_r['qty'];
				$order_id  = $dispatch_r['order_id'];

				$remaining_qty = $this->db->rp_getValue("order_product_item", "remaining_qty", "pro_id='".$pro_id."' AND weight_id='".$weight_id."' AND order_id='".$order_id."'", 0);

				$final_remaining_qty = ($remaining_qty)+($qty);

				$dispatch_qty = $this->db->rp_getValue("order_product_item", "dispatched_qty", "pro_id='".$pro_id."' AND weight_id='".$weight_id."' AND order_id='".$order_id."'", 0);

				$final_dispatch_qty = ($dispatch_qty)-($qty);

				$rows = array(
					"remaining_qty"  => $final_remaining_qty,
					"dispatched_qty" => $final_dispatch_qty,
					"status"         => 0,
				);
				$where             = "order_id='".$order_id."' AND pro_id='".$pro_id."' AND weight_id='".$weight_id."'";
				$orderItemUpdated  = $this->db->rp_update("order_product_item", $rows, $where, 0);
				$OrderStatusUpdate = $this->db->rp_update("orders", array("status" => 1), "id='".$order_id."'", 0);

				/* update product stock qty(-)*/
				//update stock qty(-) of product when Delete dispatch
				$all_order_items_with_pid = $this->db->rp_getData("product_weight_price", "*", "product_id='".$pro_id."' AND weight_id='".$weight_id."'", "id ASC", 0);
				$receive_qty              = $qty;
				if ($all_order_items_with_pid) {
					$current_order_item = mysqli_fetch_assoc($all_order_items_with_pid);
					$product_qty        = $current_order_item['stock_qty'];
					if ($receive_qty > 0) {
						$new_receive_qty     = $product_qty+$receive_qty;
						$row                 = array("stock_qty" => $new_receive_qty);
						$update_dispatch_qty = $this->db->rp_update("product_weight_price", $row, "product_id='".$pro_id."' AND weight_id='".$weight_id."'", 0);
					} else {
						break;
					}
				}
				/*END update product stock qty*/

			}
			$reply = array("ack" => 1, "developer_msg" => "deleted Dispatch.", "ack_msg" => "Success! Delete Dispatch Successfully.", "type" => $_REQUEST['id']);
			return $reply;
		} else {
			$reply = array("ack" => 0, "developer_msg" => "Database error!!", "ack_msg" => "Failed! Delete Dispatch Failed.");
			return $reply;
		}
	}

	public function updateStatus($order_id) {
		$order_items = $this->db->rp_getData("order_product_item", "*", "order_id='".$order_id."'", "", 0);
		if ($order_items) {
			$order_status = 2;
			while ($order_item = mysqli_fetch_assoc($order_items)) {
				$how_much_dispatched = $this->db->rp_getValue("dispatch_item", "SUM(qty)", "order_id='".$order_id."' AND pro_id='".$order_item['pro_id']."' AND weight_id='".$order_item['weight_id']."' AND isDelete=0");

				$ordered_qty   = $order_item['pro_qty'];
				$remaining_qty = $ordered_qty-$how_much_dispatched;

				if ($remaining_qty > 0) {
					$order_status = 4;
					$item_status  = 4;
				} else {
					$item_status = 1;
				}

				$this->db->rp_update("order_product_item", array("remaining_qty" => $remaining_qty, " dispatched_qty" => $how_much_dispatched, "status" => $item_status), "id='".$order_item['id']."'", 0);
			}
			$this->db->rp_update("orders", array("status" => $order_status), "id='".$order_id."'");
		} else {
			return 0;
		}

	}
	public function checkStockAvailability($item, $order_id) {

		$isValid = true;
		$error   = array();
		foreach ($item as $key => $i) {
			$where = "order_id='".$order_id."' AND pro_id='".$i['product_id']."' AND weight_id='".$i['weight_id']."' AND isDelete=0";

			$order_item = $this->db->rp_getData("order_product_item", "*", $where, "", 0);
			$order_item = mysqli_fetch_assoc($order_item);
			if ($order_item) {
				$item_name           = $order_item['pro_name'];
				$old_outwarded_stock = $this->db->rp_getValue("dispatch_item", "qty", "order_id='".$order_item['order_id']."' AND pro_id='".$order_item['pro_id']."' AND weight_id='".$order_item['weight_id']."'", 0);
				if ($old_outwarded_stock != "") {
					$old_outwarded_stock = floatval($old_outwarded_stock);
				} else {
					$old_outwarded_stock = 0;
				}

				$current_stock = $this->db->rp_getValue("product_weight_price", "stock_qty", "product_id='".$order_item['pro_id']."' AND weight_id='".$order_item['weight_id']."'", 0);

				$new_stock = $current_stock+$old_outwarded_stock-$i['qty'];

				if ($new_stock < 0) {
					$isValid = false;
					$error[] = "Product ".$item_name." not available in stock.";
				}
			} else {
				/*$isValid=false;
			$error[]="Some item edited in Orders try again";*/
			}
		}
		return array("isValid" => $isValid, "error" => $error);
	}

	/////// service Functions  //////////////
	public function GetDispatchDetail($detail) {
		extract($detail);
		$dispatch_detail = $this->db->rp_getData($this->ctable, "*", "id='".$dispatch_id."' AND isDelete=0");
		if ($dispatch_detail) {
			$dispatch_detail                  = mysqli_fetch_assoc($dispatch_detail);
			$dispatch_detail['dispatch_date'] = ($dispatch_detail['dispatch_date'] != "0000-00-00")?date('d-m-Y', strtotime($dispatch_detail['dispatch_date'])):"";
			$dispatch_items                   = $this->db->rp_getData("dispatch_item", "*", "dispatch_id='".$dispatch_id."'");
			if ($dispatch_items) {
				while ($dispatch_item = mysqli_fetch_assoc($dispatch_items)) {
					$result[] = $dispatch_item;
				}
			}
			$dispatch_detail['item'] = $result;
			$result                  = $dispatch_detail;
			$reply                   = array("ack" => 1, "ack_msg" => "Dispatch Found", "result" => $result);
		} else {
			$reply = array("ack" => 0, "ack_msg" => "Dispatch Not Found");
		}
		return $reply;
	}
	public function GetDispatchOrderDetail($detail) {
		extract($detail);
		$dispatch_details = $this->db->rp_getData($this->ctable, "*", "order_id='".$order_id."' AND isDelete=0");
		if ($dispatch_details) {
			while ($dispatch_detail = mysqli_fetch_assoc($dispatch_details)) {
				$dispatch_detail['dispatch_date'] = ($dispatch_detail['dispatch_date'] != "0000-00-00")?date('d-m-Y', strtotime($dispatch_detail['dispatch_date'])):"";
				$result[]                         = $dispatch_detail;
			}
			$reply = array("ack" => 1, "ack_msg" => "Dispatch Found", "result" => $result);
		} else {
			$reply = array("ack" => 0, "ack_msg" => "Dispatch Not Found");
		}
		return $reply;
	}

	public function addDispatchPayment($id) {
		$dispatch_detailDetail = $this->rp_getData("dispatch_detail", "*", "id='".$id."'", "", 0);
		if ($dispatch_detailDetail) {
			$Data_d      = mysqli_fetch_assoc($dispatch_detailDetail);
			$account_id  = $this->db->rp_getValue("account", "id", "cid='".$Data_d['customer_id']."'", 0);
			$account_no  = $this->db->rp_getValue("account", "acc_no", "cid='".$Data_d['customer_id']."'", 0);
			$description = "dispatch_detail Payment Of dispatch_detail No is :#".$Data_d['dispatch_no']." Amount of ".$Data_d['grand_total_rounded']." RS";
			$isCheck     = $this->db->rp_getTotalRecord("account_transaction", "isDelete=0 AND reference_table='dispatch_detail' AND reference_id='".$id."'", 0);
			if ($isCheck > 0) {
				$insert = $this->db->rp_update("account_transaction", array("cid" => $Data_d['customer_id'], "account_id" => $account_id, "account_no" => $account_no, "amount" => $Data_d['grand_total_rounded'], "debit" => (-$Data_d['grand_total_rounded']), "description" => $description), "isDelete=0 AND reference_table='dispatch_detail' AND reference_id='".$id."'", 0);
			} else {
				$row1 = array(
					"reference_table",
					"reference_id",
					"cid",
					"account_id",
					"account_no",
					"amount",
					"debit",
					"type",
					"description",
					"payment_date"
				);
				$value1 = array(
					'dispatch_detail',
					$id,
					$Data_d['customer_id'],
					$account_id,
					$account_no,
					$Data_d['grand_total_rounded'],
					(-$Data_d['grand_total_rounded']),
					'2',
					$description,
					date('Y-m-d')
				);
				$insert = $this->db->rp_insert("account_transaction", $value1, $row1, 0);
			}
			if ($insert) {
				$result = array("ack" => 1, "ack_msg" => "Dispatch Detail Payment Add Successfully");
			} else {
				$result = array("ack" => 1, "ack_msg" => "Dispatch Detail Payment Payment Not Add");
			}
		} else {
			$result = array("ack" => 1, "ack_msg" => "Dispatch Detail Payment Not Found");
		}
		return $result;
	}

	function getLimit($limit = array()) {
		$limit = $this->db->getLimit();
		if (!empty($limit) && array_key_exists("ul", $limit)) {
			$ul = $limit['ul'];
			if (array_key_exists("ll", $limit) && $limit['ll'] != "") {
				$ll = $limit['ll'];
			} else {
				$ll = "18446744073709551615";
			}
			$limit_string = "".$ul.",".$ll;
			return $limit_string;
		} else {
			return "";
		}
	}

}
